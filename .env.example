
# Gov Bot API Configuration

# 1. Security
# The key required in the X-API-Key header for all requests
GOV_BOT_API_KEY=your-secret-api-key-here

# 2. Database
# Path to your Firebase Service Account JSON
# If running in an environment where you are already logged in (like gcloud auth), this might be optional
# But for the script/API, it's best to be explicit.
FIREBASE_CREDENTIALS_JSON="path/to/your/serviceAccountKey.json"

# 3. AI Models
# Key for Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Key for OpenRouter (if using fallback or other models)
OPENROUTER_API_KEY=your-openrouter-key-here

# 4. Application Settings
# Default strategy if none specified
CYBERGOV_VOTING_STRATEGY=neutral
